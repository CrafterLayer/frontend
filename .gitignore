# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.cache/

# Framework, build, test, and Storybook output
dist/
build/
.next/
.nuxt/
.output/
.vite/
.turbo/
.nx/
coverage/
storybook-static/
playwright-report/
test-results/
