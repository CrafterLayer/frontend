# The compiler/export endpoints work without an AI provider.
PORT=8787
CRAFTKIT_AI_TOKEN=replace-with-a-local-development-token

# Optional legacy plan provider.
# ANTHROPIC_API_KEY=sk-ant-...
# CRAFTKIT_AI_MODEL=claude-sonnet-4-5

# Optional authored-file Agent. These role aliases are capability-probed at startup;
# unavailable or incompatible models keep /v1/agent/run disabled rather than silently falling back.
# CRAFTKIT_AI_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# CRAFTKIT_AI_MODEL=provider/default-model
# CRAFTKIT_AI_LUNA_MODEL=provider/low-cost-model
# CRAFTKIT_AI_TERRA_MODEL=provider/code-model
# CRAFTKIT_AI_SOL_MODEL=provider/design-model
# CRAFTKIT_AI_ASTRA_MODEL=provider/escalation-model
