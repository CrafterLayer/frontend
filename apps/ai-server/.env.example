# Copy to apps/ai-server/.env (git-ignored). `pnpm --filter @craftkit/ai-server dev|start`
# loads it through `node --env-file-if-exists=.env`; a variable already exported in the
# shell wins over the file.

# Credentials — standard Anthropic SDK resolution. Required for any plan to be produced
# on the default backend (CRAFTKIT_AI_BACKEND unset or "sdk").
ANTHROPIC_API_KEY=

# Optional. Which backend answers:
#   sdk         (default) the Anthropic Messages API with ANTHROPIC_API_KEY above.
#   openrouter  any model OpenRouter fronts, with the OPENROUTER_API_KEY below.
#   cli         DEV ONLY. Routes plans through the local `claude` CLI (whatever session
#               it's already logged into), so prompt.ts can be tested before any key
#               exists. No structured-output enforcement, no real refusal detection, no
#               usage/cache metrics — never set this anywhere but your own machine.
#               See src/cli-client.ts.
CRAFTKIT_AI_BACKEND=

# OpenRouter backend (CRAFTKIT_AI_BACKEND=openrouter). The key from openrouter.ai/keys.
# CRAFTKIT_AI_MODEL is REQUIRED on this backend and must be an OpenRouter slug — vendor/model,
# e.g. anthropic/claude-sonnet-4.5 or google/gemini-2.5-pro; the server refuses to start with
# anything else. See src/openrouter-client.ts and the README.
OPENROUTER_API_KEY=

# Optional. Comma-separated models a request may name in its `x-craftkit-ai-model` header
# (the playground's model picker, VITE_AI_PLAN_MODELS), beyond CRAFTKIT_AI_MODEL. Unset ⇒
# only the default model is accepted; any other choice is refused with 400. On the
# openrouter backend these are slugs too — plus HYBRID entries: `cli:haiku`, `cli:sonnet`
# or a bare `cli:` route that choice to the local `claude` CLI (your own subscription, no
# API billing) while everything else stays on OpenRouter. See src/routing-client.ts.
CRAFTKIT_AI_MODELS=

# Optional, openrouter backend only. A cli: entry that answers INSTEAD when an OpenRouter
# model is rate limited, overloaded, or unreachable (429/502). The panel's progress line
# says it switched. Unset ⇒ such failures reach the panel with a Retry button.
CRAFTKIT_AI_FALLBACK=

# Optional, OpenRouter only. Reasoning budget sent as `reasoning.effort`:
# none | minimal | low | medium | high | xhigh. Unset sends no reasoning field, leaving the
# model's own default. When the model reasons, its reasoning narrates the panel's progress
# line, as it does on the sdk backend.
CRAFTKIT_AI_OPENROUTER_EFFORT=

# Optional, OpenRouter only. Forces response_format.json_schema.strict on ("true") or off
# ("false") for EVERY model. Unset, constrained decoding is used only for Anthropic and
# OpenAI models that declare `structured_outputs` (asked at startup); every other model gets
# the schema as TEXT only — a provider's guided decoding once turned every name in a plan
# into a single letter ("command":"w"), the shortest string the schema admits.
CRAFTKIT_AI_OPENROUTER_STRICT=

# Optional. Output ceiling per answer in tokens; default 32000, which fits a full-page plan.
# Raise it for models that can write more; the OpenRouter backend clamps every request to
# what the chosen model actually allows, so a high value here is safe.
CRAFTKIT_AI_MAX_TOKENS=

# Optional, OpenRouter only. Defaults to https://openrouter.ai/api/v1; a proxy goes here.
CRAFTKIT_AI_OPENROUTER_BASE_URL=

# Optional, CLI backend only. Reasoning budget: low | medium | high | xhigh | max.
# Unset leaves the CLI's own default. Note that with this backend the reasoning TEXT is
# redacted (every thinking delta arrives empty), so a higher effort buys plan quality,
# not a more detailed progress line.
CRAFTKIT_AI_CLI_EFFORT=

# Optional, CLI backend only. Whole-run cap in milliseconds; default 600000 (10 minutes).
# A full-page plan is 15-25k output tokens and the CLI writes ~80 a second, so anything
# near two minutes kills real plans mid-generation.
CRAFTKIT_AI_CLI_TIMEOUT_MS=

# Optional. Bearer token every request must carry; set it for anything but localhost.
# The playground sends VITE_AI_PLAN_TOKEN from apps/playground/.env.local as this token.
CRAFTKIT_AI_TOKEN=

# Optional. Comma-separated browser origins allowed to call the server. Unset ⇒ loopback
# (localhost, 127.0.0.1, [::1]) on any port. An explicit list replaces that default.
CRAFTKIT_AI_ALLOWED_ORIGINS=

# Optional. Defaults: 8787 and the server's pinned model (sdk/cli backends). On the
# openrouter backend CRAFTKIT_AI_MODEL is required and must be a vendor/model slug.
PORT=
CRAFTKIT_AI_MODEL=
