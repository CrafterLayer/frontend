{
  "name": "@craftkit/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "eval": "vite build && promptfoo eval --config promptfooconfig.yaml",
    "eval:view": "promptfoo view",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@craftkit/builder": "workspace:*"
  },
  "devDependencies": {
    "@craftkit/eslint-config": "workspace:*",
    "@craftkit/test-config": "workspace:*",
    "@craftkit/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "promptfoo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
