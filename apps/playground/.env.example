# Copy to .env.local (gitignored) and fill in.
#
# Leave VITE_AI_PLAN_ENDPOINT unset and the deterministic offline provider
# answers every assistant request — nothing here is required to run the app.

# The Claude server: `pnpm --filter @craftkit/ai-server dev` listens on 8787.
# On a loopback http:// endpoint the playground allows plain HTTP in dev only.
#
# If the OLD dev bridge (scripts/ai-plan-bridge.mjs) is still running it holds
# the same port, and every request goes to it instead — with its own prompt,
# and none of the server's behaviour. Check with:
#   lsof -nP -iTCP:8787 -sTCP:LISTEN
VITE_AI_PLAN_ENDPOINT=http://localhost:8787

# Sent as `Authorization: Bearer …`. Must match CRAFTKIT_AI_TOKEN on the
# server when that is set; leave empty for an unauthenticated local server.
VITE_AI_PLAN_TOKEN=

# Optional. Comma-separated OpenRouter slugs the assistant header offers as a model
# picker (none or one ⇒ no picker). The server must list the same models in
# CRAFTKIT_AI_MODELS, or it answers 400 for a choice it does not allow.
VITE_AI_PLAN_MODELS=

# Which agent panel the playground mounts: `v2` (the redesign under
# src/features/agent/, per the 2026-09-28 chat spec; the default, also when this
# is unset or anything else) or `v1` (the old AssistantPanel, kept for one release
# as the rollback). Set `v1` to roll back.
VITE_AGENT_PANEL=v2

# The v2 panel's language. Unset (default): the editor's own language, chosen in
# Settings and remembered. `ar` or `en` pins it (the live screenshots' halves).
# VITE_AGENT_LOCALE=ar

# Optional. The model an EDIT or a NEW SECTION runs on (a page build keeps the
# model picked in the panel). Unset: the fastest of VITE_AI_PLAN_MODELS by the
# server's own ranking (haiku/flash/lite/mini/nano/small/luna/instant/turbo first,
# then sonnet/terra/medium, `:free` slugs last in their tier); with no models
# listed either, the server's default answers. The server must allow it
# (CRAFTKIT_AI_MODELS), or it answers 400.
VITE_AI_EDIT_MODEL=

# Optional. The reasoning effort for that edit model: `low` (default: an edit is
# one section read against an outline) or `medium`.
VITE_AI_EDIT_EFFORT=low
