# Copy to .env.local (gitignored) and fill in.
#
# Leave VITE_AI_PLAN_ENDPOINT unset and the deterministic offline provider
# answers every assistant request — nothing here is required to run the app.

# The Claude server: `pnpm --filter @craftkit/ai-server dev` listens on 8787.
# On a loopback http:// endpoint the playground allows plain HTTP in dev only.
#
# If the OLD dev bridge (scripts/ai-plan-bridge.mjs) is still running it holds
# the same port, and every request goes to it instead — with its own prompt,
# and none of the server's behaviour. Check with:
#   lsof -nP -iTCP:8787 -sTCP:LISTEN
VITE_AI_PLAN_ENDPOINT=http://localhost:8787

# Sent as `Authorization: Bearer …`. Must match CRAFTKIT_AI_TOKEN on the
# server when that is set; leave empty for an unauthenticated local server.
VITE_AI_PLAN_TOKEN=

# Optional. Comma-separated OpenRouter slugs the assistant header offers as a model
# picker (none or one ⇒ no picker). The server must list the same models in
# CRAFTKIT_AI_MODELS, or it answers 400 for a choice it does not allow.
VITE_AI_PLAN_MODELS=

# Which agent panel the playground mounts: `v1` (the current AssistantPanel) or
# `v2` (the redesign under src/features/agent/, per the 2026-09-28 chat spec).
# Stays `v1` until the v2 panel passes its acceptance; flip it back to roll back.
VITE_AGENT_PANEL=v1
