  "checkProfiles": [
    { "id": "ck-typecheck", "cwd": ".", "argv": ["pnpm", "typecheck"] },
    { "id": "ck-lint", "cwd": ".", "argv": ["pnpm", "lint"] },
    { "id": "ck-test", "cwd": ".", "argv": ["pnpm", "test"] },
    { "id": "ck-boundaries", "cwd": ".", "argv": ["pnpm", "check:boundaries"] },
    { "id": "ck-components", "cwd": ".", "argv": ["pnpm", "check:components"] }
  ],
  "requiredChecks": {
    "always": [],
    "byKind": {
      "implementation": ["ck-components"],
      "refactor": ["ck-boundaries"],
      "integration": ["ck-boundaries"]
    },
    "byRisk": {
      "high": ["ck-boundaries"],
      "critical": ["ck-boundaries", "ck-components"]
    },
    "byAuthority": {
      "write": ["ck-typecheck", "ck-lint", "ck-test"]
    }
  },
  "codexPolicy": {
    "default": {
      "model": "gpt-5.6-luna",
