      "debugging": { "model": "gpt-5.6-terra", "reasoningEffort": "high" },
      "architecture": { "model": "gpt-5.6-terra", "reasoningEffort": "high" },
      "security-review": { "model": "gpt-5.6-sol", "reasoningEffort": "high" }
