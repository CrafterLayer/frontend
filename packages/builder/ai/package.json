{
  "name": "@craftkit/builder-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./script-node": "./src/script/node.ts"
  },
  "scripts": {
    "benchmark:scene-init": "node scripts/measure-scene-init.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@craftkit/builder-core": "workspace:*",
    "@craftkit/builder-schema": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "htmlparser2": "catalog:",
    "open-props": "catalog:",
    "quickjs-emscripten-core": "catalog:"
  },
  "devDependencies": {
    "@craftkit/eslint-config": "workspace:*",
    "@craftkit/test-config": "workspace:*",
    "@craftkit/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
