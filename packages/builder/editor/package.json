{
  "name": "@craftkit/builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./css": {
      "types": "./src/chrome.css.d.ts",
      "default": "./src/chrome.css"
    },
    "./tailwind.css": {
      "types": "./src/tailwind.css.d.ts",
      "default": "./src/tailwind.css"
    },
    "./motion.css": {
      "types": "./src/motion.css.d.ts",
      "default": "./src/motion.css"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@craftkit/builder-aceternity": "workspace:*",
    "@craftkit/builder-ai": "workspace:*",
    "@craftkit/builder-blocks-marketing": "workspace:*",
    "@craftkit/builder-code-view": "workspace:*",
    "@craftkit/builder-core": "workspace:*",
    "@craftkit/builder-magicui": "workspace:*",
    "@craftkit/builder-motion": "workspace:*",
    "@craftkit/builder-primitives": "workspace:*",
    "@craftkit/builder-react": "workspace:*",
    "@craftkit/builder-renderer": "workspace:*",
    "@craftkit/builder-richtext": "workspace:*",
    "@craftkit/builder-schema": "workspace:*",
    "@craftkit/builder-shadcn": "workspace:*",
    "@craftkit/builder-shell": "workspace:*",
    "@craftkit/builder-theme": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@craftkit/eslint-config": "workspace:*",
    "@craftkit/test-config": "workspace:*",
    "@craftkit/typescript-config": "workspace:*",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
