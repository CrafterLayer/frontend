{
  "name": "@craftkit/builder-media-engines",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    "./entry": "./src/entry.ts",
    "./policy": "./src/policy.ts",
    "./palette": "./src/palette.ts",
    "./carousel": "./src/carousel.ts"
  },
  "scripts": {
    "build:scene": "node ../../../../scripts/build-scene-engine.mjs scene",
    "build:pixi": "node ../../../../scripts/build-scene-engine.mjs pixi",
    "build:studio": "node ../../../../scripts/build-studio-engines.mjs all",
    "build:sound": "node ../../../../scripts/build-sound-engine.mjs",
    "build:carousel": "node ../../../../scripts/build-carousel-engine.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@craftkit/builder-schema": "workspace:*",
    "@pixi/sound": "catalog:",
    "@pixi/tilemap": "catalog:",
    "@pixi/ui": "catalog:",
    "embla-carousel": "catalog:",
    "inkjs": "catalog:",
    "matter-js": "catalog:",
    "perfect-freehand": "catalog:",
    "pixi-filters": "catalog:",
    "pixi-viewport": "catalog:",
    "pixi.js": "catalog:",
    "roughjs": "catalog:",
    "simplex-noise": "catalog:",
    "yuka": "catalog:",
    "zzfx": "catalog:"
  },
  "devDependencies": {
    "@craftkit/eslint-config": "workspace:*",
    "@craftkit/test-config": "workspace:*",
    "@craftkit/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/yuka": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
