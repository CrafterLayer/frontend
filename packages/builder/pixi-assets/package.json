{
  "name": "@craftkit/builder-pixi-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build-time PixiJS asset pipeline (AssetPack): compressed images, half-resolution variants, texture atlases, audio and a PixiJS manifest. Node only; nothing here ships to a page.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite-plugin.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "craftkit-pixi-assets": "./src/cli.ts"
  },
  "scripts": {
    "assets": "node src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@assetpack/core": "catalog:"
  },
  "devDependencies": {
    "@craftkit/eslint-config": "workspace:*",
    "@craftkit/test-config": "workspace:*",
    "@craftkit/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
