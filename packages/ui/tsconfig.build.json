{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/index.ts",
    "src/globals.d.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.tsx"]
}
