{
  "name": "@craftkit/workspace-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Non-mutating workspace and UI component contract checks for CraftKit.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./components": "./src/components/validate-components.mjs",
    "./workspace": "./src/workspace/validate-workspace.mjs",
    "./package.json": "./package.json",
    "./files": "./src/files/validate-file-sizes.mjs"
  },
  "bin": {
    "craftkit-check-components": "./src/cli/check-components.mjs",
    "craftkit-check-workspace": "./src/cli/check-workspace.mjs",
    "craftkit-check-file-sizes": "./src/cli/check-file-sizes.mjs"
  },
  "scripts": {
    "build": "node --check src/index.mjs",
    "lint": "node --check src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "node --check src/index.mjs"
  }
}
